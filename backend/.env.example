# ==========================================
# Notification System Environment Variables
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-notification-system-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# 1. WhatsApp Cloud API (Meta Sandbox)
# From Meta for Developers (developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
# Optional default test recipient phone (e.g. +1234567890)
WHATSAPP_DEFAULT_TEST_PHONE=

# 2. Email Service (Postmark / Resend / Brevo)
# Option A: Postmark (Named in assignment doc)
POSTMARKAPP_TOKEN=
POSTMARK_FROM_EMAIL=notifications@yourdomain.com

# Option B: Resend (Alternative free transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option C: Brevo (Alternative free 300 emails/day)
BREVO_API_KEY=
BREVO_FROM_EMAIL=notifications@yourdomain.com

# 3. Web Push Service
# Option A: Native VAPID WebPush (Works directly in browser without third party)
# You can generate a pair using: pywebpush or we supply a default development pair
VAPID_PUBLIC_KEY=BC_4Y-7v6E2o9p0eS3s8hZ6k7q1rA2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s0t1u2v3w4x5y6z7a8b9c0d1e2f3
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_ADMIN_EMAIL=mailto:admin@example.com

# Option B: OneSignal (Free tier Web Push)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
